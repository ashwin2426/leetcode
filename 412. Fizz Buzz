class Solution:
    def fizzBuzz(self, n: int) -> List[str]:
        m4=[]
        for i in range(1, n+1):
            if i%3==0 and i%5==0:
                m4.append("FizzBuzz")
            elif i%3==0:
                m4.append("Fizz")
            elif i%5==0:
                m4.append("Buzz")
            else:
                m4.append(str(i))
        return m4               
