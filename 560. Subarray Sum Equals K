class Solution:

  def subarraySum(self, nums: List[int], k: int) -> int:
    count = current_sum = 0
    prefix_counts = {0: 1}
    for num in nums:
      current_sum += num
      count += prefix_counts.get(current_sum - k, 0)
      prefix_counts[current_sum] = prefix_counts.get(current_sum, 0) + 1
    return count
    
